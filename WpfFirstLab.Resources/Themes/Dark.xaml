<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема: Dark. Ключи общие для всех тем, значения подменяются при смене темы. -->
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1F2937"/>
</ResourceDictionary>
