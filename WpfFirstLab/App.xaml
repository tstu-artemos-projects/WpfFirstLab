<Application x:Class="WpfFirstLab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WpfFirstLab.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Кисти текущей темы (подменяются сервисом тем) -->
                <ResourceDictionary Source="pack://application:,,,/WpfFirstLab.Resources;component/Themes/Light.xaml"/>
                <!-- Стили и шаблоны из библиотеки ресурсов -->
                <ResourceDictionary Source="pack://application:,,,/WpfFirstLab.Resources;component/Styles/AllStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:PercentConverter x:Key="Percent"/>
            <conv:ValueToBrushConverter x:Key="ValueToBrush"/>
            <conv:FullNameConverter x:Key="FullName"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
