<Window x:Class="WpfFirstLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfFirstLab"
        mc:Ignorable="d"
        Title="Главное окно" Height="720" Width="1000" MinHeight="480" MinWidth="720"
        FontFamily="{Binding Settings.SelectedFont}"
        FontSize="{Binding Settings.FontSize}">
    <!-- DataContext (MainViewModel) задаётся в MainWindow.xaml.cs; каждая вкладка получает свою дочернюю модель -->
    <TabControl Margin="8">
        <TabItem Header="{Binding [TabCommon], Source={StaticResource Loc}}" Name="CommonTab">
            <local:CommonTabView DataContext="{Binding Settings}"/>
        </TabItem>
        <TabItem Header="{Binding [TabPalette], Source={StaticResource Loc}}" Name="ColorPaletteTab">
            <local:PaletteTabView DataContext="{Binding Settings}"/>
        </TabItem>
        <TabItem Header="{Binding [TabControls], Source={StaticResource Loc}}" Name="ControlElementsTab">
            <local:ControlsTabView/>
        </TabItem>
        <TabItem Header="{Binding [TabLayout], Source={StaticResource Loc}}" Name="LayoutContainersTab">
            <local:LayoutTabView/>
        </TabItem>
        <TabItem Header="{Binding [TabTable], Source={StaticResource Loc}}" Name="TableTab">
            <local:TableTabView DataContext="{Binding Table}"/>
        </TabItem>
        <TabItem Header="{Binding [TabBindings], Source={StaticResource Loc}}" Name="BindingsTab">
            <local:BindingsTabView DataContext="{Binding Bindings}"/>
        </TabItem>
    </TabControl>
</Window>
