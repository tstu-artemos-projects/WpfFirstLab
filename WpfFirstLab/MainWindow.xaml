<Window x:Class="WpfFirstLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfFirstLab"
        mc:Ignorable="d"
        Title="Главное окно" Height="720" Width="1000" MinHeight="480" MinWidth="720">
    <TabControl Margin="8">
        <TabItem Header="Основное" Name="CommonTab">
            <local:CommonTabView/>
        </TabItem>
        <TabItem Header="Цветовая палитра" Name="ColorPaletteTab">
            <local:PaletteTabView/>
        </TabItem>
        <TabItem Header="Элементы управления" Name="ControlElementsTab">
            <local:ControlsTabView/>
        </TabItem>
        <TabItem Header="Контейнеры компоновки" Name="LayoutContainersTab">
            <local:LayoutTabView/>
        </TabItem>
    </TabControl>
</Window>
