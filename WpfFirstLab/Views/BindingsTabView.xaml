<UserControl x:Class="WpfFirstLab.BindingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CodingSeb.Localization;assembly=CodingSeb.Localization">
    <!-- DataContext — BindingsViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 1. Mode -->
            <GroupBox Header="{Tr 'BindModes'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="OneWay — источник → приёмник. Часы обновляет таймер модели:"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Clock, Mode=OneWay}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="OneTime — значение читается один раз при создании привязки (часы «замерли»):"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Clock, Mode=OneTime}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="TwoWay — два поля одного свойства; правка в любом отражается в другом:"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220" Margin="0,0,8,8"
                                 Text="{Binding SharedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220"
                                 Text="{Binding SharedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Text="OneWayToSource — поле только пишет в источник (при создании очищает его):"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220" Margin="0,0,8,8"
                                 Text="{Binding Sink, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Style="{StaticResource BodyText}"
                                   Text="{Binding Sink, StringFormat='В источнике: {0}'}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Text="Default — у TextBox.Text по умолчанию TwoWay, у TextBlock.Text — OneWay:"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220" Margin="0,0,8,8"
                                 Text="{Binding DefaultModeText}"/>
                        <TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Style="{StaticResource BodyText}"
                                   Text="{Binding DefaultModeText}"/>
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Command="{Binding ChangeFromCodeCommand}" Content="Изменить значения из модели (источник → приёмник)"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. UpdateSourceTrigger -->
            <GroupBox Header="{Tr 'BindTriggers'}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="PropertyChanged" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding PropertyChangedText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                               Text="{Binding PropertyChangedText, StringFormat='В источнике: {0}'}"/>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="LostFocus" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding LostFocusText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                               Text="{Binding LostFocusText, StringFormat='В источнике: {0}'}"/>

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Default (для Text — LostFocus)" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding DefaultTriggerText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                               Text="{Binding DefaultTriggerText, StringFormat='В источнике: {0}'}"/>

                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Explicit (по кнопке)" Style="{StaticResource BodyText}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="ExplicitBox" Style="{StaticResource ColorTextBox}" Width="150" Margin="0,0,8,8"
                                 Text="{Binding ExplicitText, UpdateSourceTrigger=Explicit}"/>
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Padding="8,4"
                                Content="Применить" Click="ApplyExplicit_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                               Text="{Binding ExplicitText, StringFormat='В источнике: {0}'}"/>

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="PropertyChanged + Delay=800" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding DelayedText, UpdateSourceTrigger=PropertyChanged, Delay=800}"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                               Text="{Binding DelayedText, StringFormat='В источнике: {0}'}"/>
                </Grid>
            </GroupBox>

            <!-- 3. Источники привязки -->
            <GroupBox Header="{Tr 'BindSources'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="DataContext (по умолчанию) — все привязки выше берут данные из BindingsViewModel."/>

                    <TextBlock Style="{StaticResource Caption}" Text="ElementName — привязка к другому элементу: ползунок управляет числом и индикатором:"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Slider x:Name="DemoSlider" Width="260" Minimum="0" Maximum="100" Value="40" VerticalAlignment="Center"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                                   Text="{Binding Value, ElementName=DemoSlider, StringFormat={}{0:0}}"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" Maximum="100" Width="260" HorizontalAlignment="Left"
                                 Value="{Binding Value, ElementName=DemoSlider}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="RelativeSource Self — свойство самого элемента:"/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{Binding ActualWidth, RelativeSource={RelativeSource Self}, StringFormat='Ширина этого TextBlock: {0:0} px'}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="RelativeSource FindAncestor — свойство родителя заданного типа (GroupBox):"/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=GroupBox}, StringFormat='Ширина внешнего GroupBox: {0:0} px'}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Source — произвольный объект (здесь Loc.Instance из библиотеки CodingSeb.Localization):"/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, StringFormat='Текущий язык: {0}'}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="TemplatedParent — используется в шаблонах кнопок библиотеки ресурсов (цвет берётся у элемента, к которому применён шаблон)."/>
                </StackPanel>
            </GroupBox>

            <!-- 4. Конвертеры и форматирование -->
            <GroupBox Header="{Tr 'BindConverters'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Converter + ConverterParameter: значение ползунка → «40 %» и цвет роли (ошибка / информация / успех):"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="60"
                                   Text="{Binding Value, ElementName=DemoSlider, Converter={StaticResource Percent}, ConverterParameter=100}"/>
                        <Border Width="160" Height="20" CornerRadius="4"
                                Background="{Binding Value, ElementName=DemoSlider, Converter={StaticResource ValueToBrush}}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Text="BooleanToVisibilityConverter: флажок показывает и скрывает текст:"/>
                    <CheckBox Content="Показать подробности" IsChecked="{Binding ShowDetails}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="Подробности отображаются, пока флажок установлен."
                               Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="MultiBinding + IMultiValueConverter и MultiBinding + StringFormat:"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="150" Margin="0,0,8,8"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Style="{StaticResource ColorTextBox}" Width="150"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FullName}">
                                <Binding Path="LastName"/>
                                <Binding Path="FirstName"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Имя: {1}, фамилия: {0}">
                                <Binding Path="LastName"/>
                                <Binding Path="FirstName"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Caption}" Text="TargetNullValue (источник вернул null) и FallbackValue (путь не найден):"/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{Binding NullableText, TargetNullValue='(значение не задано)'}"/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{Binding NoSuchProperty, FallbackValue='(свойство не найдено)'}"/>
                </StackPanel>
            </GroupBox>

            <!-- 5. INotifyPropertyChanged -->
            <GroupBox Header="{Tr 'BindNotify'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Оба счётчика увеличиваются одной командой. Интерфейс видит только тот, что уведомляет об изменении:"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Counter, StringFormat='Counter (INotifyPropertyChanged): {0}'}"/>
                    <TextBlock x:Name="PlainText" Style="{StaticResource BodyText}"
                               Text="{Binding Plain.Value, StringFormat='Plain.Value (без уведомлений): {0}'}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding IncrementCommand}" Content="Увеличить"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Перечитать привязку (UpdateTarget)" Click="RefreshPlain_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 6. Проверка данных -->
            <GroupBox Header="{Tr 'BindValidation'}" Padding="10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ValidatesOnExceptions: исключение в set-методе Age или ошибка преобразования показываются как ошибка ввода. Введите, например, 200 или «abc»:"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AgeBox" Width="120" Margin="0,0,12,0"
                                 Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=AgeBox}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
