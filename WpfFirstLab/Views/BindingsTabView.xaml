<UserControl x:Class="WpfFirstLab.BindingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CodingSeb.Localization;assembly=CodingSeb.Localization">
    <!-- DataContext — BindingsViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 1. Mode -->
            <GroupBox Header="{Tr 'BindModes'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindOneWay'}"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Clock, Mode=OneWay}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindOneTime'}"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Clock, Mode=OneTime}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindTwoWay'}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220" Margin="0,0,8,8"
                                 Text="{Binding SharedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220"
                                 Text="{Binding SharedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindOneWayToSource'}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220" Margin="0,0,8,8"
                                 Text="{Binding Sink, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Style="{StaticResource BodyText}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindSinkFormat">
                                    <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                    <Binding Path="Sink"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindDefault'}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="220" Margin="0,0,8,8"
                                 Text="{Binding DefaultModeText}"/>
                        <TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Style="{StaticResource BodyText}"
                                   Text="{Binding DefaultModeText}"/>
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Command="{Binding ChangeFromCodeCommand}" Content="{Tr 'BindChangeFromCode'}"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. UpdateSourceTrigger -->
            <GroupBox Header="{Tr 'BindTriggers'}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="PropertyChanged" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding PropertyChangedText, UpdateSourceTrigger=PropertyChanged}"/>
                     <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                         <TextBlock.Text>
                             <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindSinkFormat">
                                 <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                 <Binding Path="PropertyChangedText"/>
                             </MultiBinding>
                         </TextBlock.Text>
                     </TextBlock>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="LostFocus" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding LostFocusText, UpdateSourceTrigger=LostFocus}"/>
                     <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                         <TextBlock.Text>
                             <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindSinkFormat">
                                 <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                 <Binding Path="LostFocusText"/>
                             </MultiBinding>
                         </TextBlock.Text>
                     </TextBlock>

                     <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Tr 'BindTriggerDefault'}" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding DefaultTriggerText}"/>
                     <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                         <TextBlock.Text>
                             <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindSinkFormat">
                                 <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                 <Binding Path="DefaultTriggerText"/>
                             </MultiBinding>
                         </TextBlock.Text>
                     </TextBlock>

                     <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Tr 'BindTriggerExplicit'}" Style="{StaticResource BodyText}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="ExplicitBox" Style="{StaticResource ColorTextBox}" Width="150" Margin="0,0,8,8"
                                 Text="{Binding ExplicitText, UpdateSourceTrigger=Explicit}"/>
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Padding="8,4"
                                 Content="{Tr 'BindApply'}" Click="ApplyExplicit_Click"/>
                    </StackPanel>
                     <TextBlock Grid.Row="3" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                         <TextBlock.Text>
                             <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindSinkFormat">
                                 <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                 <Binding Path="ExplicitText"/>
                             </MultiBinding>
                         </TextBlock.Text>
                     </TextBlock>

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="PropertyChanged + Delay=800" Style="{StaticResource BodyText}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ColorTextBox}"
                             Text="{Binding DelayedText, UpdateSourceTrigger=PropertyChanged, Delay=800}"/>
                     <TextBlock Grid.Row="4" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                         <TextBlock.Text>
                             <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindSinkFormat">
                                 <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                 <Binding Path="DelayedText"/>
                             </MultiBinding>
                         </TextBlock.Text>
                     </TextBlock>
                </Grid>
            </GroupBox>

            <!-- 3. Источники привязки -->
            <GroupBox Header="{Tr 'BindSources'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindDataContext'}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindElementName'}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Slider x:Name="DemoSlider" Width="260" Minimum="0" Maximum="100" Value="40" VerticalAlignment="Center"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                                   Text="{Binding Value, ElementName=DemoSlider, StringFormat={}{0:0}}"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" Maximum="100" Width="260" HorizontalAlignment="Left"
                                 Value="{Binding Value, ElementName=DemoSlider}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindRelativeSelf'}"/>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindSelfWidthFormat">
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindRelativeAncestor'}"/>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindAncestorWidthFormat">
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=GroupBox}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindSource'}"/>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindCurrentLanguageFormat">
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindTemplatedParent'}"/>
                </StackPanel>
            </GroupBox>

            <!-- 4. Конвертеры и форматирование -->
            <GroupBox Header="{Tr 'BindConverters'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindConverterParam'}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="60"
                                   Text="{Binding Value, ElementName=DemoSlider, Converter={StaticResource Percent}, ConverterParameter=100}"/>
                        <Border Width="160" Height="20" CornerRadius="4"
                                Background="{Binding Value, ElementName=DemoSlider, Converter={StaticResource ValueToBrush}}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindBoolToVis'}"/>
                    <CheckBox Content="{Tr 'BindShowDetails'}" IsChecked="{Binding ShowDetails}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Tr 'BindDetailsText'}"
                               Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindMulti'}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ColorTextBox}" Width="150" Margin="0,0,8,8"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Style="{StaticResource ColorTextBox}" Width="150"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FullName}">
                                <Binding Path="LastName"/>
                                <Binding Path="FirstName"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                     <TextBlock Style="{StaticResource BodyText}">
                         <TextBlock.Text>
                             <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindFullNameFormat">
                                 <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                 <Binding Path="LastName"/>
                                 <Binding Path="FirstName"/>
                             </MultiBinding>
                         </TextBlock.Text>
                     </TextBlock>

                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindNullFallback'}"/>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedValue}" ConverterParameter="BindNullValue">
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                <Binding Path="NullableText" TargetNullValue="__NULL__"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedValue}" ConverterParameter="BindFallbackValue">
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                <Binding Path="NoSuchProperty" FallbackValue="__MISSING__"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- 5. INotifyPropertyChanged -->
            <GroupBox Header="{Tr 'BindNotify'}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindNotifyHint'}"/>
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindCounterFormat">
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                <Binding Path="Counter"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock x:Name="PlainText" Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BindPlainFormat">
                                <Binding Path="CurrentLanguage" Source="{x:Static loc:Loc.Instance}" Mode="OneWay"/>
                                <Binding Path="Plain.Value"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding IncrementCommand}" Content="{Tr 'BindIncrement'}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{Tr 'BindRefresh'}" Click="RefreshPlain_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 6. Проверка данных -->
            <GroupBox Header="{Tr 'BindValidation'}" Padding="10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'BindValidationHint'}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AgeBox" Width="120" Margin="0,0,12,0"
                                 Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=AgeBox}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
