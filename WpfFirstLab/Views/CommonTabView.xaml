<UserControl x:Class="WpfFirstLab.CommonTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext — SettingsViewModel -->
    <StackPanel Margin="16">

        <GroupBox Header="{Tr 'GroupPersonalization'}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="{Tr 'LabelTheme'}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                          ItemsSource="{Binding Themes}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedTheme}"/>

                <Label Grid.Row="1" Content="{Tr 'LabelLanguage'}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Width="240" HorizontalAlignment="Left"
                          ItemsSource="{Binding Languages}" DisplayMemberPath="NativeName"
                          SelectedItem="{Binding SelectedLanguage}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{Tr 'GroupFonts'}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="{Tr 'LabelFont'}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                          ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Label Grid.Row="1" Content="{Tr 'LabelFontSize'}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <Slider Width="260" Minimum="8" Maximum="32" TickFrequency="2" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            Value="{Binding FontSize}"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="48"
                               Text="{Binding FontSize, StringFormat={}{0:0} pt}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

    </StackPanel>
</UserControl>
