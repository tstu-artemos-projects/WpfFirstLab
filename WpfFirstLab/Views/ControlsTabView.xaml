<UserControl x:Class="WpfFirstLab.ControlsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:loc="clr-namespace:CodingSeb.Localization;assembly=CodingSeb.Localization"
              xmlns:local="clr-namespace:WpfFirstLab"
             xmlns:res="clr-namespace:WpfFirstLab.Resources;assembly=WpfFirstLab.Resources">
    <UserControl.Resources>
        <DataTemplate x:Key="ButtonsTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <StackPanel>
                    <TextBlock Text="{Tr 'CtrlButtonsHint'}" Style="{StaticResource Caption}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Tr 'CtrlPrimary'}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{Tr 'CtrlSecondary'}"/>
                        <Button Style="{StaticResource TertiaryButton}" Content="{Tr 'CtrlTertiary'}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Tr 'CtrlDisabledButton'}" IsEnabled="False"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{Tr 'CtrlDisabledButton'}" IsEnabled="False"/>
                        <Button Style="{StaticResource TertiaryButton}" Content="{Tr 'CtrlDisabledButton'}" IsEnabled="False"/>
                    </WrapPanel>

                    <TextBlock Text="{Tr 'CtrlIconButtonsHint'}" Style="{StaticResource Caption}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE710;" ToolTip="{Tr 'Add'}"/>
                        <Button Style="{StaticResource SecondaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE70F;" ToolTip="{Tr 'Update'}"/>
                        <Button Style="{StaticResource TertiaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE74D;" ToolTip="{Tr 'Delete'}"/>
                        <Button Style="{StaticResource PrimaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE713;" IsEnabled="False"/>
                        <Button Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0"/>
                                <TextBlock Text="{Tr 'CtrlSave'}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="{Tr 'CtrlTogglesHint'}" Style="{StaticResource Caption}"/>
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource PrimaryButton}" Content="{Tr 'CtrlTurnOn'}"/>
                        <ToggleButton Style="{StaticResource PrimaryButton}" Content="{Tr 'CtrlOn'}" IsChecked="True"/>
                        <ToggleButton Style="{StaticResource SecondaryButton}" Content="{Tr 'CtrlOn'}" IsChecked="True"/>
                        <ToggleButton Style="{StaticResource PrimaryButton}" Content="{Tr 'CtrlDisabled'}" IsEnabled="False"/>
                        <ToggleButton Style="{StaticResource SwitchToggle}"/>
                        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="True" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="InputsTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{Tr 'CtrlListBoxHint'}" Style="{StaticResource Caption}"/>
                        <ListBox Style="{StaticResource ColorListBox}" Height="110" SelectedIndex="1">
                            <ListBoxItem Content="{Tr 'CtrlFirstItem'}"/>
                            <ListBoxItem Content="{Tr 'CtrlSecondItem'}"/>
                            <ListBoxItem Content="{Tr 'CtrlThirdItem'}"/>
                            <ListBoxItem Content="{Tr 'CtrlUnavailable'}" IsEnabled="False"/>
                        </ListBox>
                        <TextBlock Text="{Tr 'CtrlComboBoxHint'}" Style="{StaticResource Caption}"/>
                        <Border BorderBrush="{Binding Brush}" BorderThickness="1.5" CornerRadius="6" Padding="1" Margin="0,0,0,6">
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="{Tr 'CtrlOption1'}"/>
                                <ComboBoxItem Content="{Tr 'CtrlOption2'}"/>
                                <ComboBoxItem Content="{Tr 'CtrlOption3'}"/>
                            </ComboBox>
                        </Border>
                        <Border BorderBrush="{Binding Brush}" BorderThickness="1.5" CornerRadius="6" Padding="1" Opacity="0.5">
                            <ComboBox SelectedIndex="0" IsEnabled="False">
                                <ComboBoxItem Content="{Tr 'CtrlDisabled'}"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="{Tr 'CtrlTextBoxHint'}" Style="{StaticResource Caption}"/>
                        <TextBox Style="{StaticResource ColorTextBox}"
                                 Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=CtrlEnterText}"/>
                        <TextBox Style="{StaticResource ColorTextBox}" IsReadOnly="True"
                                 Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=CtrlReadOnly}"/>
                        <TextBox Style="{StaticResource ColorTextBox}" IsEnabled="False"
                                 Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=CtrlDisabled}"/>
                        <TextBlock Text="{Tr 'CtrlPasswordHint'}" Style="{StaticResource Caption}"/>
                        <PasswordBox Style="{StaticResource ColorPasswordBox}" Password="12345678"/>
                        <PasswordBox Style="{StaticResource ColorPasswordBox}" Password="12345678" IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Tr 'CtrlRichHint'}" Style="{StaticResource Caption}"/>
                        <RichTextBox Style="{StaticResource ColorRichTextBox}" Height="90" Margin="0,0,0,8">
                            <FlowDocument>
                                <Paragraph><Run Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=RichNormalPrefix}"/><Bold><Run Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=RichBold}"/></Bold>,<Italic><Run Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=RichItalic}"/></Italic><Run Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=RichAnd}"/><Underline><Run Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=RichUnderline}"/></Underline><Run Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=RichSuffix}"/></Paragraph>
                            </FlowDocument>
                        </RichTextBox>
                        <RichTextBox Style="{StaticResource ColorRichTextBox}" Height="60" IsEnabled="False">
                            <FlowDocument>
                                <Paragraph><Run Text="{Binding CurrentLanguage, Source={x:Static loc:Loc.Instance}, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=RichDisabled}"/></Paragraph>
                            </FlowDocument>
                        </RichTextBox>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TextBlock" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Tr 'CtrlHeading1'}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Tr 'CtrlHeading2'}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Tr 'CtrlHeading3'}" Style="{StaticResource H3}"/>
                        <TextBlock Text="{Tr 'CtrlBody'}" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Tr 'CtrlCaption'}" Style="{StaticResource Caption}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Label" Style="{StaticResource Caption}"/>
                        <Label Content="{Tr 'CtrlHeading1'}" FontSize="28" FontWeight="Bold" Foreground="{Binding Brush}" Padding="0"/>
                        <Label Content="{Tr 'CtrlHeading2'}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Brush}" Padding="0"/>
                        <Label Content="{Tr 'CtrlHeading3'}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Brush}" Padding="0"/>
                        <Label Content="{Tr 'CtrlBody'}" FontSize="14" Padding="0,2"/>
                        <Label Content="{Tr 'CtrlCaption'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Padding="0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="TreeTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <WrapPanel>
                    <TreeView Style="{StaticResource ColorTreeView}" Width="260" Height="150" Margin="0,0,12,0">
                        <TreeViewItem Header="{Tr 'CtrlProject'}" IsExpanded="True">
                            <TreeViewItem Header="{Tr 'CtrlModels'}" IsExpanded="True">
                                <TreeViewItem Header="Student.cs" IsSelected="True"/>
                                <TreeViewItem Header="Palette.cs"/>
                            </TreeViewItem>
                            <TreeViewItem Header="{Tr 'CtrlViews'}">
                                <TreeViewItem Header="MainWindow.xaml"/>
                            </TreeViewItem>
                            <TreeViewItem Header="{Tr 'CtrlUnavailableNode'}" IsEnabled="False"/>
                        </TreeViewItem>
                    </TreeView>
                    <TreeView Style="{StaticResource ColorTreeView}" Width="260" Height="150" IsEnabled="False" Opacity="0.6">
                        <TreeViewItem Header="{Tr 'CtrlDisabledTree'}" IsExpanded="True">
                            <TreeViewItem Header="{Tr 'CtrlNode1'}"/>
                            <TreeViewItem Header="{Tr 'CtrlNode2'}"/>
                        </TreeViewItem>
                    </TreeView>
                </WrapPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="GridTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <DataGrid Style="{StaticResource ColorDataGrid}"
                          ItemsSource="{x:Static local:SampleData.Students}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Width="50" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="{Tr 'ColStudent'}" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="{Tr 'ColGroup'}" Width="160" Binding="{Binding Group}"/>
                        <DataGridTextColumn Header="{Tr 'ColScore'}" Width="80" Binding="{Binding Score}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="ProgressTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <StackPanel>
                    <TextBlock Text="{Tr 'CtrlDeterminateProgress'}" Style="{StaticResource Caption}"/>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" Value="70" Maximum="100"/>
                    <TextBlock Text="{Tr 'CtrlIndeterminateProgress'}" Style="{StaticResource Caption}"/>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" IsIndeterminate="True"/>
                    <TextBlock Text="{Tr 'CtrlDisabledProgress'}" Style="{StaticResource Caption}"/>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" Value="40" Maximum="100" IsEnabled="False" Opacity="0.5"/>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="ToolTipsTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <WrapPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Tr 'CtrlSimpleTooltipButton'}">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource ColorToolTip}" Content="{Tr 'CtrlSimpleTooltip'}"/>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Tr 'CtrlTooltipWithHeaderButton'}">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource ColorToolTip}">
                                <StackPanel>
                                    <TextBlock Text="{Tr 'CtrlTooltipHeader'}" FontWeight="Bold"/>
                                    <TextBlock Text="{Tr 'CtrlTooltipDetails'}"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Tr 'CtrlDisabledButton'}" IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource ColorToolTip}" Content="{Tr 'CtrlDisabledTooltip'}"/>
                        </Button.ToolTip>
                    </Button>
                </WrapPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="MenusTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <StackPanel>
                    <TextBlock Text="{Tr 'CtrlMenu'}" Style="{StaticResource Caption}"/>
                    <Menu Background="{Binding LightBrush}" Foreground="{Binding DarkBrush}" Margin="0,0,0,8">
                        <MenuItem Header="{Tr 'CtrlFile'}">
                            <MenuItem Header="{Tr 'CtrlOpen'}" InputGestureText="Ctrl+O"/>
                            <MenuItem Header="{Tr 'CtrlAutosave'}" IsCheckable="True" IsChecked="True"/>
                            <Separator/>
                            <MenuItem Header="{Tr 'CtrlUnavailableItem'}" IsEnabled="False"/>
                        </MenuItem>
                        <MenuItem Header="{Tr 'CtrlEdit'}">
                            <MenuItem Header="{Tr 'Copy'}"/>
                            <MenuItem Header="{Tr 'Paste'}"/>
                        </MenuItem>
                        <MenuItem Header="{Tr 'CtrlView'}">
                            <MenuItem Header="{Tr 'CtrlZoom'}">
                                <MenuItem Header="100 %"/>
                                <MenuItem Header="150 %"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <TextBlock Text="{Tr 'CtrlContextMenuHint'}" Style="{StaticResource Caption}"/>
                    <Border Background="{Binding LightBrush}" BorderBrush="{Binding Brush}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <TextBlock Text="{Tr 'CtrlRightClickHere'}" Foreground="{Binding DarkBrush}"/>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Tr 'Copy'}"/>
                                <MenuItem Header="{Tr 'Paste'}"/>
                                <Separator/>
                                <MenuItem Header="{Tr 'CtrlMore'}">
                                    <MenuItem Header="{Tr 'CtrlProperties'}"/>
                                    <MenuItem Header="{Tr 'CtrlOptions'}"/>
                                </MenuItem>
                                <MenuItem Header="{Tr 'CtrlUnavailableItem'}" IsEnabled="False"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                    </Border>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" res:Ui.ForwardWheel="True">
        <StackPanel Margin="16">

            <Expander Header="{Tr 'ExpButtons'}" IsExpanded="True" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource ButtonsTemplate}"/>
            </Expander>

            <Expander Header="{Tr 'ExpInputs'}" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource InputsTemplate}"/>
            </Expander>

            <Expander Header="{Tr 'ExpText'}" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource TextTemplate}"/>
            </Expander>

            <Expander Header="{Tr 'ExpTree'}" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource TreeTemplate}"/>
            </Expander>

            <Expander Header="{Tr 'ExpGrid'}" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource GridTemplate}"/>
            </Expander>

            <Expander Header="{Tr 'ExpProgress'}" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource ProgressTemplate}"/>
            </Expander>

            <Expander Header="{Tr 'ExpToolTips'}" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource ToolTipsTemplate}"/>
            </Expander>

            <Expander Header="{Tr 'ExpMenus'}" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource MenusTemplate}"/>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
