<UserControl x:Class="WpfFirstLab.ControlsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfFirstLab"
             xmlns:res="clr-namespace:WpfFirstLab.Resources;assembly=WpfFirstLab.Resources">
    <UserControl.Resources>
        <DataTemplate x:Key="ButtonsTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <StackPanel>
                    <TextBlock Text="Обычные кнопки: основная, вторичная, третичная (наведение и нажатие — мышью)" Style="{StaticResource Caption}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Основная"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Вторичная"/>
                        <Button Style="{StaticResource TertiaryButton}" Content="Третичная"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Отключена" IsEnabled="False"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Отключена" IsEnabled="False"/>
                        <Button Style="{StaticResource TertiaryButton}" Content="Отключена" IsEnabled="False"/>
                    </WrapPanel>

                    <TextBlock Text="Кнопки-пиктограммы (шрифт Segoe MDL2 Assets)" Style="{StaticResource Caption}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE710;" ToolTip="Добавить"/>
                        <Button Style="{StaticResource SecondaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE70F;" ToolTip="Изменить"/>
                        <Button Style="{StaticResource TertiaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE74D;" ToolTip="Удалить"/>
                        <Button Style="{StaticResource PrimaryButton}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Padding="9" Content="&#xE713;" IsEnabled="False"/>
                        <Button Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0"/>
                                <TextBlock Text="Сохранить"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Переключатели: кнопка-переключатель и тумблер (выключен, включён, отключён)" Style="{StaticResource Caption}"/>
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource PrimaryButton}" Content="Включить"/>
                        <ToggleButton Style="{StaticResource PrimaryButton}" Content="Включено" IsChecked="True"/>
                        <ToggleButton Style="{StaticResource SecondaryButton}" Content="Включено" IsChecked="True"/>
                        <ToggleButton Style="{StaticResource PrimaryButton}" Content="Отключён" IsEnabled="False"/>
                        <ToggleButton Style="{StaticResource SwitchToggle}"/>
                        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="True" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="InputsTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="ListBox (выбран, отключён элемент)" Style="{StaticResource Caption}"/>
                        <ListBox Style="{StaticResource ColorListBox}" Height="110" SelectedIndex="1">
                            <ListBoxItem Content="Первый элемент"/>
                            <ListBoxItem Content="Второй элемент"/>
                            <ListBoxItem Content="Третий элемент"/>
                            <ListBoxItem Content="Недоступный" IsEnabled="False"/>
                        </ListBox>
                        <TextBlock Text="ComboBox (обычный, отключён)" Style="{StaticResource Caption}"/>
                        <Border BorderBrush="{Binding Brush}" BorderThickness="1.5" CornerRadius="6" Padding="1" Margin="0,0,0,6">
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Вариант 1"/>
                                <ComboBoxItem Content="Вариант 2"/>
                                <ComboBoxItem Content="Вариант 3"/>
                            </ComboBox>
                        </Border>
                        <Border BorderBrush="{Binding Brush}" BorderThickness="1.5" CornerRadius="6" Padding="1" Opacity="0.5">
                            <ComboBox SelectedIndex="0" IsEnabled="False">
                                <ComboBoxItem Content="Отключён"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="TextBox (обычный, только чтение, отключён)" Style="{StaticResource Caption}"/>
                        <TextBox Style="{StaticResource ColorTextBox}" Text="Введите текст"/>
                        <TextBox Style="{StaticResource ColorTextBox}" Text="Только чтение" IsReadOnly="True"/>
                        <TextBox Style="{StaticResource ColorTextBox}" Text="Отключён" IsEnabled="False"/>
                        <TextBlock Text="PasswordBox (обычный, отключён)" Style="{StaticResource Caption}"/>
                        <PasswordBox Style="{StaticResource ColorPasswordBox}" Password="12345678"/>
                        <PasswordBox Style="{StaticResource ColorPasswordBox}" Password="12345678" IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RichTextBox (обычный, отключён)" Style="{StaticResource Caption}"/>
                        <RichTextBox Style="{StaticResource ColorRichTextBox}" Height="90" Margin="0,0,0,8">
                            <FlowDocument>
                                <Paragraph>Обычный, <Bold>жирный</Bold>, <Italic>курсивный</Italic> и <Underline>подчёркнутый</Underline> текст.</Paragraph>
                            </FlowDocument>
                        </RichTextBox>
                        <RichTextBox Style="{StaticResource ColorRichTextBox}" Height="60" IsEnabled="False">
                            <FlowDocument>
                                <Paragraph>Отключённое поле.</Paragraph>
                            </FlowDocument>
                        </RichTextBox>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TextBlock" Style="{StaticResource Caption}"/>
                        <TextBlock Text="Заголовок 1" Style="{StaticResource H1}"/>
                        <TextBlock Text="Заголовок 2" Style="{StaticResource H2}"/>
                        <TextBlock Text="Заголовок 3" Style="{StaticResource H3}"/>
                        <TextBlock Text="Обычный текст абзаца." Style="{StaticResource BodyText}"/>
                        <TextBlock Text="Подпись к элементу" Style="{StaticResource Caption}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Label" Style="{StaticResource Caption}"/>
                        <Label Content="Заголовок 1" FontSize="28" FontWeight="Bold" Foreground="{Binding Brush}" Padding="0"/>
                        <Label Content="Заголовок 2" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Brush}" Padding="0"/>
                        <Label Content="Заголовок 3" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Brush}" Padding="0"/>
                        <Label Content="Обычный текст абзаца." FontSize="14" Padding="0,2"/>
                        <Label Content="Подпись к элементу" FontSize="12" Foreground="{DynamicResource MutedBrush}" Padding="0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="TreeTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <WrapPanel>
                    <TreeView Style="{StaticResource ColorTreeView}" Width="260" Height="150" Margin="0,0,12,0">
                        <TreeViewItem Header="Проект" IsExpanded="True">
                            <TreeViewItem Header="Модели" IsExpanded="True">
                                <TreeViewItem Header="Student.cs" IsSelected="True"/>
                                <TreeViewItem Header="Palette.cs"/>
                            </TreeViewItem>
                            <TreeViewItem Header="Представления">
                                <TreeViewItem Header="MainWindow.xaml"/>
                            </TreeViewItem>
                            <TreeViewItem Header="Недоступный узел" IsEnabled="False"/>
                        </TreeViewItem>
                    </TreeView>
                    <TreeView Style="{StaticResource ColorTreeView}" Width="260" Height="150" IsEnabled="False" Opacity="0.6">
                        <TreeViewItem Header="Отключённое дерево" IsExpanded="True">
                            <TreeViewItem Header="Узел 1"/>
                            <TreeViewItem Header="Узел 2"/>
                        </TreeViewItem>
                    </TreeView>
                </WrapPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="GridTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <DataGrid Style="{StaticResource ColorDataGrid}"
                          ItemsSource="{x:Static local:SampleData.Students}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Width="50" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Студент" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Группа" Width="160" Binding="{Binding Group}"/>
                        <DataGridTextColumn Header="Балл" Width="80" Binding="{Binding Score}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="ProgressTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <StackPanel>
                    <TextBlock Text="Определённый прогресс (70 %)" Style="{StaticResource Caption}"/>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" Value="70" Maximum="100"/>
                    <TextBlock Text="Неопределённый прогресс" Style="{StaticResource Caption}"/>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" IsIndeterminate="True"/>
                    <TextBlock Text="Отключённый (40 %)" Style="{StaticResource Caption}"/>
                    <ProgressBar Style="{StaticResource ColorProgressBar}" Value="40" Maximum="100" IsEnabled="False" Opacity="0.5"/>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="ToolTipsTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <WrapPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="Простая подсказка">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource ColorToolTip}" Content="Это обычная всплывающая подсказка"/>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Content="Подсказка с заголовком">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource ColorToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Заголовок подсказки" FontWeight="Bold"/>
                                    <TextBlock Text="Дополнительное пояснение к элементу"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Content="Отключена" IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource ColorToolTip}" Content="Подсказка у отключённого элемента"/>
                        </Button.ToolTip>
                    </Button>
                </WrapPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="MenusTemplate">
            <GroupBox Header="{Binding Title}" Padding="8" Margin="0,0,0,8" res:Ui.Brush="{Binding Brush}">
                <StackPanel>
                    <TextBlock Text="Меню" Style="{StaticResource Caption}"/>
                    <Menu Background="{Binding LightBrush}" Foreground="{Binding DarkBrush}" Margin="0,0,0,8">
                        <MenuItem Header="Файл">
                            <MenuItem Header="Открыть" InputGestureText="Ctrl+O"/>
                            <MenuItem Header="Автосохранение" IsCheckable="True" IsChecked="True"/>
                            <Separator/>
                            <MenuItem Header="Недоступный пункт" IsEnabled="False"/>
                        </MenuItem>
                        <MenuItem Header="Правка">
                            <MenuItem Header="Копировать"/>
                            <MenuItem Header="Вставить"/>
                        </MenuItem>
                        <MenuItem Header="Вид">
                            <MenuItem Header="Масштаб">
                                <MenuItem Header="100 %"/>
                                <MenuItem Header="150 %"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <TextBlock Text="Контекстное меню (правая кнопка мыши по области)" Style="{StaticResource Caption}"/>
                    <Border Background="{Binding LightBrush}" BorderBrush="{Binding Brush}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <TextBlock Text="Нажмите здесь правой кнопкой мыши" Foreground="{Binding DarkBrush}"/>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать"/>
                                <MenuItem Header="Вставить"/>
                                <Separator/>
                                <MenuItem Header="Дополнительно">
                                    <MenuItem Header="Свойства"/>
                                    <MenuItem Header="Параметры"/>
                                </MenuItem>
                                <MenuItem Header="Недоступный пункт" IsEnabled="False"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                    </Border>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" res:Ui.ForwardWheel="True">
        <StackPanel Margin="16">

            <Expander Header="1. Кнопки" IsExpanded="True" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource ButtonsTemplate}"/>
            </Expander>

            <Expander Header="2. ListBox, ComboBox, TextBox, PasswordBox, RichTextBox" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource InputsTemplate}"/>
            </Expander>

            <Expander Header="3. TextBlock и Label" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource TextTemplate}"/>
            </Expander>

            <Expander Header="4. TreeView" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource TreeTemplate}"/>
            </Expander>

            <Expander Header="5. DataGrid" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource GridTemplate}"/>
            </Expander>

            <Expander Header="6. ProgressBar" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource ProgressTemplate}"/>
            </Expander>

            <Expander Header="7. Всплывающие подсказки" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource ToolTipsTemplate}"/>
            </Expander>

            <Expander Header="8. Меню и контекстное меню" Margin="0,0,0,8">
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Static res:Palette.Roles}"
                              ItemTemplate="{StaticResource MenusTemplate}"/>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
