<UserControl x:Class="WpfFirstLab.LayoutTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfFirstLab"
             xmlns:res="clr-namespace:WpfFirstLab.Resources;assembly=WpfFirstLab.Resources">
    <UserControl.Resources>

        <Style x:Key="Tile" TargetType="Label">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Demo" TargetType="GroupBox">
            <Setter Property="Width" Value="290"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="DemoFrame" TargetType="Border">
            <Setter Property="Height" Value="190"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" res:Ui.ForwardWheel="True">
        <WrapPanel Margin="16">

            <GroupBox Header="{Tr 'LayoutStackVertical'}" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutStackVerticalHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <StackPanel>
                            <Label Style="{StaticResource Tile}" Content="1" Height="36"/>
                            <Label Style="{StaticResource Tile}" Content="2" Height="36" Background="{StaticResource AccentBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="3" Height="36" Background="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{Tr 'LayoutStackHorizontal'}" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutStackHorizontalHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{StaticResource Tile}" Content="1" Width="60"/>
                            <Label Style="{StaticResource Tile}" Content="2" Width="80" Background="{StaticResource AccentBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="3" Width="50" Background="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="WrapPanel" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutWrapPanelHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <WrapPanel>
                            <Label Style="{StaticResource Tile}" Content="1" Width="60" Height="40"/>
                            <Label Style="{StaticResource Tile}" Content="2" Width="60" Height="40" Background="{StaticResource AccentBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="3" Width="60" Height="40" Background="{StaticResource SuccessBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="4" Width="60" Height="40" Background="{StaticResource ErrorBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="5" Width="60" Height="40" Background="{StaticResource InfoBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="6" Width="60" Height="40"/>
                            <Label Style="{StaticResource Tile}" Content="7" Width="60" Height="40" Background="{StaticResource AccentBrush}"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="DockPanel" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutDockPanelHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <DockPanel>
                            <Label DockPanel.Dock="Top" Style="{StaticResource Tile}" Content="Top" Height="30"/>
                            <Label DockPanel.Dock="Bottom" Style="{StaticResource Tile}" Content="Bottom" Height="30" Background="{StaticResource AccentBrush}"/>
                            <Label DockPanel.Dock="Left" Style="{StaticResource Tile}" Content="Left" Width="60" Background="{StaticResource SuccessBrush}"/>
                            <Label DockPanel.Dock="Right" Style="{StaticResource Tile}" Content="Right" Width="60" Background="{StaticResource ErrorBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="Fill" Background="{StaticResource InfoBrush}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Grid" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutGridHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}" Content="Auto" Padding="10,4"/>
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Tile}" Content="ColumnSpan = 2" Background="{StaticResource AccentBrush}"/>
                            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}" Content="1*" Background="{StaticResource SuccessBrush}"/>
                            <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" Content="1*" Background="{StaticResource ErrorBrush}"/>
                            <Label Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}" Content="2*" Background="{StaticResource InfoBrush}"/>
                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Tile}" Content="{Tr 'LayoutRowSpan'}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="UniformGrid" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutUniformHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <UniformGrid Rows="2" Columns="3">
                            <Label Style="{StaticResource Tile}" Content="1"/>
                            <Label Style="{StaticResource Tile}" Content="2" Background="{StaticResource AccentBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="3" Background="{StaticResource SuccessBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="4" Background="{StaticResource ErrorBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="5" Background="{StaticResource InfoBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="6"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Canvas" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutCanvasHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <Canvas>
                            <Label Style="{StaticResource Tile}" Content="10, 10" Canvas.Left="10" Canvas.Top="10" Width="90" Height="50"/>
                            <Label Style="{StaticResource Tile}" Content="80, 40" Canvas.Left="80" Canvas.Top="40" Width="90" Height="50" Background="{StaticResource AccentBrush}" Opacity="0.9"/>
                            <Label Style="{StaticResource Tile}" Content="150, 100" Canvas.Left="150" Canvas.Top="100" Width="100" Height="60" Background="{StaticResource SuccessBrush}" Opacity="0.9"/>
                        </Canvas>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{Tr 'LayoutBorderAlignment'}" Style="{StaticResource Demo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Tr 'LayoutAlignmentHint'}"/>
                    <Border Style="{StaticResource DemoFrame}">
                        <Grid>
                            <Label Style="{StaticResource Tile}" Content="Left / Top" Width="90" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Label Style="{StaticResource Tile}" Content="Center" Width="90" Height="40" Background="{StaticResource AccentBrush}"/>
                            <Label Style="{StaticResource Tile}" Content="Right / Bottom" Width="110" Height="40" Background="{StaticResource ErrorBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </GroupBox>

        </WrapPanel>
    </ScrollViewer>
</UserControl>
