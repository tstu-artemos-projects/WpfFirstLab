<UserControl x:Class="WpfFirstLab.PaletteTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfFirstLab">
    <UserControl.Resources>

        <DataTemplate x:Key="SwatchTemplate">
            <Border Width="190" Height="96" Margin="0,0,12,8" Padding="12" CornerRadius="8"
                    Background="{Binding Brush}">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Hex}" Foreground="White" FontSize="12"/>
                    <TextBlock Text="{Binding Rgb}" Foreground="White" FontSize="12"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShadesTemplate">
            <Expander Header="{Binding TableTitle}" Margin="0,0,0,6"
                      local:Ui.Brush="{Binding Brush}">
                <DataGrid Style="{StaticResource ColorDataGrid}" Margin="0,6,0,6"
                          ItemsSource="{Binding Shades}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Цвет" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Height="18" Width="56" CornerRadius="4" Margin="4,2"
                                            HorizontalAlignment="Left" Background="{Binding Brush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RGB-код" Width="160" Binding="{Binding Rgb}"/>
                        <DataGridTextColumn Header="HEX" Width="120" Binding="{Binding Hex}"/>
                        <DataGridTextColumn Header="Наименование" Width="*" Binding="{Binding Name}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" local:Ui.ForwardWheel="True">
        <StackPanel Margin="16">

            <TextBlock FontSize="18" Margin="0,0,0,12">
                <Run Text="Текущая тема приложения: "/>
                <Run Text="{x:Static local:Palette.ThemeName}" FontWeight="Bold"/>
            </TextBlock>

            <GroupBox Header="Основные цвета" Padding="12" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{x:Static local:Palette.BaseRoles}"
                              ItemTemplate="{StaticResource SwatchTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </GroupBox>

            <GroupBox Header="Индикаторные цвета" Padding="12" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{x:Static local:Palette.StatusRoles}"
                              ItemTemplate="{StaticResource SwatchTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </GroupBox>

            <GroupBox Header="Оттенки цветов (10 оттенков для каждого цвета)" Padding="12">
                <ItemsControl ItemsSource="{x:Static local:Palette.Roles}"
                              ItemTemplate="{StaticResource ShadesTemplate}"/>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
