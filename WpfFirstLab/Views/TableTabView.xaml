<UserControl x:Class="WpfFirstLab.TableTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfFirstLab.ViewModels"
             xmlns:b="clr-namespace:WpfFirstLab.Behaviors"
             xmlns:res="clr-namespace:WpfFirstLab.Resources;assembly=WpfFirstLab.Resources">
    <!-- DataContext — TableViewModel. Все действия выполняются командами, code-behind пуст. -->
    <DockPanel Margin="16">

        <ToolBar DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" Text="{Tr 'Add'}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding UpdateCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" Text="{Tr 'Update'}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" Text="{Tr 'Delete'}"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding CopyCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" Text="{Tr 'Copy'}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding PasteCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77F;" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" Text="{Tr 'Paste'}"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8"
                   Text="{Tr 'TableHint'}"/>

        <!-- Форма редактирования записи: заполнение, изменение -->
        <GroupBox DockPanel.Dock="Bottom" Padding="10" Margin="0,8,0,0"
                  Header="{Tr 'GroupEditor'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{Tr 'FieldName'}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource ColorTextBox}" Margin="0,0,12,0"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Column="2" Content="{Tr 'FieldGroup'}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Style="{StaticResource ColorTextBox}" Margin="0,0,12,0"
                         Text="{Binding EditGroup, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Column="4" Content="{Tr 'FieldScore'}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Style="{StaticResource ColorTextBox}" Margin="0,0,12,0"
                         Text="{Binding EditScore, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                            Content="{Tr 'Add'}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding UpdateCommand}"
                            Content="{Tr 'Update'}" Margin="0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Padding="6"
                      b:FocusBehavior.Command="{Binding ActivateCommand}"
                      b:FocusBehavior.CommandParameter="{x:Static vm:TableSide.Left}">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Tr 'TableSource'}"/>
                        <TextBlock Margin="8,0,0,0" Foreground="{StaticResource PrimaryBrush}"
                                   Text="{Tr 'Active'}"
                                   Visibility="{Binding IsLeftActive, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </GroupBox.Header>
                <DataGrid Style="{StaticResource ColorDataGrid}" IsReadOnly="False" SelectionMode="Single"
                          ItemsSource="{Binding Left}" SelectedItem="{Binding SelectedLeft, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Width="50" IsReadOnly="True" Binding="{Binding Id, Mode=OneTime}"/>
                        <DataGridTextColumn Header="{Tr 'ColStudent'}" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="{Tr 'ColGroup'}" Width="130" Binding="{Binding Group}"/>
                        <DataGridTextColumn Header="{Tr 'ColScore'}" Width="60" Binding="{Binding Score}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="2" Padding="6"
                      b:FocusBehavior.Command="{Binding ActivateCommand}"
                      b:FocusBehavior.CommandParameter="{x:Static vm:TableSide.Right}">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Tr 'TableTarget'}"/>
                        <TextBlock Margin="8,0,0,0" Foreground="{StaticResource PrimaryBrush}"
                                   Text="{Tr 'Active'}"
                                   Visibility="{Binding IsRightActive, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </GroupBox.Header>
                <DataGrid Style="{StaticResource ColorDataGrid}" IsReadOnly="False" SelectionMode="Single"
                          ItemsSource="{Binding Right}" SelectedItem="{Binding SelectedRight, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Width="50" IsReadOnly="True" Binding="{Binding Id, Mode=OneTime}"/>
                        <DataGridTextColumn Header="{Tr 'ColStudent'}" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="{Tr 'ColGroup'}" Width="130" Binding="{Binding Group}"/>
                        <DataGridTextColumn Header="{Tr 'ColScore'}" Width="60" Binding="{Binding Score}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
