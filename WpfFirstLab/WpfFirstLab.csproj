<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Application.ThemeMode (тема Fluent) помечен в WPF как экспериментальный API -->
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WpfFirstLab.Resources\WpfFirstLab.Resources.csproj" />
    </ItemGroup>

</Project>
