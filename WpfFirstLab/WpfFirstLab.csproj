<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Application.ThemeMode (тема Fluent) помечен в WPF как экспериментальный API -->
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Локализация: ядро, разметка {Tr} для XAML и загрузчик файлов *.loc.json -->
        <PackageReference Include="CodingSeb.Localization" Version="1.4.*" />
        <PackageReference Include="CodingSeb.Localization.WPF" Version="1.4.*" />
        <PackageReference Include="CodingSeb.Localization.JsonFileLoader" Version="1.4.*" />
    </ItemGroup>

    <ItemGroup>
        <!-- Файлы переводов копируются в каталог с исполняемым файлом -->
        <None Update="Localization\*.loc.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WpfFirstLab.Resources\WpfFirstLab.Resources.csproj" />
    </ItemGroup>

</Project>
